# ============================================================
# x402-bazaar-client 配置模板
# 复制本文件为 .env，填入你自己的凭证后使用：
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)
# ⚠️ 私钥只保存在本地，不要提交到 Git，不要发到聊天里。
# ============================================================

# ---------- NEAR 账户（推荐付款方式：NEAR 链签名，无需 CDP） ----------
# NEAR 账户 ID（主网），例如 myagent.near
NEAR_ACCOUNT_ID=

# NEAR 私钥（ed25519: 前缀，从钱包导出）
# 格式示例：ed25519:2tqpgi6...（以你实际导出的为准）
NEAR_PRIVATE_KEY=

# 可选：自定义 NEAR RPC（默认 free.rpc.fastnear.com，大陆可直连）
# NEAR_RPC_URL=https://free.rpc.fastnear.com

# ---------- CDP 钱包（备选付款方式，走 Coinbase 托管） ----------
# 只用 NEAR 付款时可留空。需要 CDP 时到 https://portal.cdp.coinbase.com 创建
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=

# ---------- 网络代理（需要时） ----------
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809
